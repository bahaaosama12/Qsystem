<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QSystem - Booking</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet" />
  <!-- Bootstrap Icons -->
  <link rel="stylesheet"  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <!-- Header -->
  <header class="text-center py-5 position-relative">
    <div class="language-switcher">
      <button type="button" id="language-en" class="btn btn-sm">English</button>
      <span>|</span>
      <button type="button" id="language-ar" class="btn btn-sm">العربية</button>
    </div>

    <h1 class="page-title">QSystem</h1>
    <p class="page-subtitle mb-0" data-i18n="subtitle">Online Booking</p>
  </header>

  <!-- Main -->
  <main class="container">
    <section class="d-flex justify-content-center">
      <div class="booking-form w-100">
        <form id="booking-form">
          <!-- Department -->
          <div class="mb-3">
            <label for="department" class="form-label" data-i18n="department">Department</label>
            <select id="department" class="form-select" required>
              <option value="" selected disabled data-i18n="selectDepartment">Select Department</option>
            </select>
          </div>

          <!-- Service -->
          <div class="mb-3">
            <label for="service" class="form-label" data-i18n="service">Service</label>
            <select id="service" class="form-select" disabled required>
              <option value="" selected disabled data-i18n="selectService">Select Service</option>
            </select>
          </div>

          <!-- Governorate -->
          <div class="mb-3">
            <label for="governorate" class="form-label" data-i18n="governorate">Governorate</label>
            <select id="governorate" class="form-select" disabled required>
              <option value="" selected disabled data-i18n="selectGovernorate">Select Governorate</option>
            </select>
          </div>

          <!-- City -->
          <div class="mb-3">
            <label for="city" class="form-label" data-i18n="city">City</label>
            <select id="city" class="form-select" disabled required>
              <option value="" selected disabled data-i18n="selectCity">Select City</option>
            </select>
          </div>

          <!-- Branch -->
          <div class="mb-3">
            <label for="branch" class="form-label" data-i18n="branch">Branch</label>
            <select id="branch" class="form-select" disabled required>
              <option value="" selected disabled data-i18n="selectBranch">Select Branch</option>
            </select>
          </div>

          <!-- Date -->
          <div class="mb-3">
            <label for="appointment-date" class="form-label" data-i18n="date">Date</label>
            <input type="date" id="appointment-date" class="form-control" disabled required />
          </div>

          <!-- Available Time -->
          <div id="time-section" class="mb-4 d-none">
            <label for="appointment-time" class="form-label" data-i18n="time">Available Time</label>
            <select id="appointment-time" class="form-select" disabled required>
              <option value="" selected disabled data-i18n="selectTime">Select Time</option>
            </select>
          </div>

          <!-- Booking -->
          <div id="booking-error" class="alert alert-danger d-none mb-3" role="alert"></div>
          <button
            type="submit"
            id="confirm-booking"
            class="btn continue-btn w-100"
            disabled
            data-i18n="booking"
          >
            Booking
          </button>
        </form>
      </div>
    </section>
  </main>
  
  <script src="/js/i18n.js"></script>
  <script src="/js/booking.js"></script>
</body>
</html>