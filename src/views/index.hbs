<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>QSystem</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  />

  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <!-- Header -->
  <header class="text-center py-5 position-relative">
    <div class="language-switcher">
      <button type="button" id="language-en" class="btn btn-sm">English</button>
      <span>|</span>
      <button type="button" id="language-ar" class="btn btn-sm">العربية</button>
    </div>

    <h1 class="page-title" data-i18n="title">QSystem</h1>
    <p class="page-subtitle mb-0" data-i18n="subtitle">Online Booking</p>
  </header>

  <!-- Main -->
  <main class="container">
    <section class="d-flex justify-content-center">
      <div class="booking-form w-100">
        <form id="customer-form">
          <div class="mb-3">
            <label for="nationalId" class="form-label" data-i18n="nationalId">National ID</label>
            <input type="text" id="nationalId" name="nationalId" inputmode="numeric" minlength="14" maxlength="14" pattern="[0-9]{14}" aria-describedby="lookup-error" class="form-control" required />
          </div>

          <div class="mb-4">
            <label for="phone" class="form-label" data-i18n="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone" inputmode="numeric" pattern="01[0125][0-9]{8}" minlength="11" maxlength="11" aria-describedby="lookup-error" class="form-control" required />
          </div>

          <div id="lookup-error" class="alert alert-danger d-none" role="alert"></div>
          <button type="submit" class="btn continue-btn w-100" data-i18n="continue">Continue</button>
        </form>
      </div>
    </section>
  </main>

  <!-- Booking Ticket Modal -->
  <div class="modal fade" id="bookingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="ticket" id="ticket">
          <button type="button" class="ticket-close" data-bs-dismiss="modal" aria-label="Close">
            <i class="bi bi-x-lg"></i>
          </button>

          <div class="ticket-logo">QSystem</div>
          <div class="ticket-subtitle" data-i18n="onlineBooking">Online Booking</div>

          <div class="ticket-divider"></div>

          <div id="ticket-branch" class="ticket-branch"></div>
          <div id="ticket-queue" class="ticket-queue"></div>
          <div id="ticket-time" class="ticket-time"></div>

          <div class="ticket-info">
            <div class="ticket-info-row">
              <div class="ticket-info-icon">
                <i class="bi bi-telephone-fill"></i>
              </div>
              <div id="ticket-phone" class="ticket-info-text"></div>
            </div>

            <div class="ticket-info-row">
              <div class="ticket-info-icon">
                <i class="bi bi-building-fill"></i>
              </div>
              <div id="ticket-department" class="ticket-info-text ticket-department"></div>
            </div>

            <div class="ticket-info-row">
              <div class="ticket-info-icon">
                <i class="bi bi-file-earmark-text-fill"></i>
              </div>
              <div id="ticket-service" class="ticket-info-text ticket-service"></div>
            </div>
          </div>

          <p class="ticket-note" data-i18n="arrivalNote">
            Please arrive at the branch no more than 10 minutes before your appointment.
          </p>

          <div class="ticket-actions">
            <div class="ticket-main-actions">
              <button type="button" id="modify-booking-btn" class="btn" data-i18n="modify">Modify</button>
              <button type="button" id="cancel-booking-btn" class="btn" data-i18n="cancel">Cancel</button>
            </div>

            <button type="button" id="download-ticket-btn" class="btn download-btn">
              <i class="bi bi-download me-2"></i>
              <span data-i18n="download">Download</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/i18n.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="/js/index.js"></script>
</body>
</html>